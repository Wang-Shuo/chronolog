    {
      "release_id": "chatgpt-2026-10-16-create-and-collaborate-on-slides-in-chatgpt-0e009a16",
      "product": "chatgpt",
      "product_name": "ChatGPT",
      "date": "2026-10-16",
      "version": "Create and collaborate on slides in ChatGPT",
      "title": "Create and collaborate on slides in ChatGPT",
      "body": "ChatGPT Slides lets you create presentations and keep working on them with your team in Space. Start from a conversation, files, or an outline, or share an example deck to guide the style and layout.\n- Create and refine. Edit text, images, shapes, and charts directly, or ask ChatGPT to make changes. Generate custom images or add your own.\n- Work together. Invite teammates to edit the same deck in real time and leave shared comments.\n- Present or export. Present directly from ChatGPT. On the web, export to PowerPoint, PDF, or Google Slides. In the desktop app, open your deck in PowerPoint or Keynote when those apps are installed.\nSlides is rolling out to eligible Pro, Business, and Enterprise users with Space access on the web and in the desktop app. To get started, ask ChatGPT in Work to create a presentation in Space.",
      "source_summary": "ChatGPT Slides lets you create presentations and keep working on them with your team in Space. Start from a conversation, files, or an outline, or share an example deck to guide the style and layout.",
      "source_url": "https://help.openai.com/en/articles/6825453-chatgpt-release-notes#create-and-collaborate-on-slides-in-chatgpt",
      "source_type": "chatgpt_changelog"
    },
    {
